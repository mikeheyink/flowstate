import { NavLink, Outlet } from 'react-router-dom';
import { Home, Calendar, BookOpen, ShoppingCart, List } from 'lucide-react';
import { motion } from 'framer-motion';

const NavItem = ({ to, icon: Icon, label }: { to: string, icon: any, label: string }) => {
    return (
        <NavLink
            to={to}
            className={({ isActive }) =>
                `flex items-center gap-4 px-5 py-3.5 rounded-2xl transition-all duration-500 group ${isActive
                    ? 'bg-white/[0.08] text-white shadow-[0_0_20px_rgba(255,255,255,0.05)] border border-white/[0.05]'
                    : 'text-white/40 hover:text-white/80 hover:bg-white/[0.03]'
                }`
            }
        >
            {({ isActive }) => (
                <>
                    <Icon size={18} strokeWidth={isActive ? 2.5 : 2} className="transition-transform duration-500 group-hover:scale-110" />
                    <span className="font-semibold text-sm tracking-tight">{label}</span>
                    {isActive && (
                        <motion.div
                            layoutId="nav-dot"
                            className="ml-auto w-1 h-1 rounded-full bg-indigo-400"
                        />
                    )}
                </>
            )}
        </NavLink>
    );
};

export const Layout = () => {
